# Names/example defaults only. This file is not loaded automatically.
# M1's existing retained keys stay in its private runtime files; do not copy or
# replace them to enable mobile authentication.
KAPIT_MOBILE_ENABLED=0
# Independent CSPRNG key: canonical unpadded base64url of 32-64 random bytes.
# Leave unset here. The later owned isolated M2 harness provisions its own key;
# never reuse Django signing, source encryption or database credentials.
# KAPIT_MOBILE_SIGNING_KEY=
# Algorithm, issuer, audience and lifetimes are fixed by the reviewed contract,
# not configurable from incoming token headers or environment overrides.

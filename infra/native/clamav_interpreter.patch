+cl_error_t cl_kapit_scanmap_strict_v1(cl_fmap_t *map, const char *filename, const char **virname, unsigned long int *scanned, const struct cl_engine *engine, struct cl_scan_options *scanoptions, void *context)
+{
+    cl_error_t result;
+    int fault;
+    if (kapit_strict.active) { kapit_strict.fault = 1; return CL_EARG; }
+    if (!map || !engine || !scanoptions || !virname || !scanned || filename || context ||
+        map->len <= 5 || map->len > 5242880 ||
+        !(engine->engine_options & ENGINE_OPTIONS_DISABLE_CACHE) ||
+        (engine->engine_options & ENGINE_OPTIONS_FORCE_TO_DISK) ||
+        cl_engine_get_num(engine, CL_ENGINE_BYTECODE_MODE, NULL) != CL_BYTECODE_MODE_INTERPRETER ||
+        engine->keeptmp || engine->sdb ||
+        engine->cb_pre_cache || engine->cb_pre_scan || engine->cb_post_scan || engine->cb_file_inspection || engine->cb_file_props ||
+        scanoptions->general != CL_SCAN_GENERAL_HEURISTICS ||
+        scanoptions->parse != CL_SCAN_PARSE_IMAGE ||
+        scanoptions->heuristic != (CL_SCAN_HEURISTIC_EXCEEDS_MAX | CL_SCAN_HEURISTIC_BROKEN_MEDIA) ||
+        scanoptions->mail || scanoptions->dev) return CL_EARG;
+    memset(&kapit_strict, 0, sizeof(kapit_strict));
+    kapit_strict.active = 1;
+    kapit_strict.root = map;
+    result = cl_scanmap_callback(map, NULL, virname, scanned, engine, scanoptions, NULL);
+    fault = kapit_strict.fault || !kapit_strict.raw || !kapit_strict.image || !kapit_strict.complete;
+    memset(&kapit_strict, 0, sizeof(kapit_strict));
+    if (result != CL_CLEAN) return result;
+    return fault ? CL_ERROR : CL_CLEAN;
+}
